# systemd unit for the honeypot server.
# Install:
#   useradd --system --no-create-home --shell /sbin/nologin honeypot
#   install -D target/honeypot-server.jar /opt/honeypot-server/honeypot-server.jar
#   install -D config/server.properties /etc/honeypot-server/server.properties
#   install -D -m 600 -o honeypot certs/server-keystore.p12 \
#       /etc/honeypot-server/server-keystore.p12
#     (in server.properties set:
#        server.keystore=/etc/honeypot-server/server-keystore.p12
#        server.keystore.password=...
#        data.dir=/var/lib/honeypot-server
#        dashboard.dir=/opt/honeypot-server/dashboard   # or leave empty)
#   cp deploy/honeypot-server.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now honeypot-server
#
# The keystore + the CA the agent trusts come from scripts/gen-certs.sh; the
# cert SAN must contain the address the agent connects to.

[Unit]
Description=Honeypot central server (collector + API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=honeypot
Group=honeypot
ExecStart=/usr/bin/java -jar /opt/honeypot-server/honeypot-server.jar /etc/honeypot-server/server.properties
Restart=on-failure
RestartSec=5

# Creates /var/lib/honeypot-server owned by the service user
StateDirectory=honeypot-server

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true

[Install]
WantedBy=multi-user.target
